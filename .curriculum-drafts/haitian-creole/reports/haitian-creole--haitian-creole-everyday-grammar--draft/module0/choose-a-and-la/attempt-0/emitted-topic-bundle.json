          },
          {
            "text": "a",
            "locale": "ht-HT",
            "pauseAfterMs": 50
          },
          {
            "text": "when the noun ends in a non-nasal vowel sound",
            "locale": "en-US",
            "pauseAfterMs": 240
          },
          {
            "text": "tifi a",
            "locale": "ht-HT",
            "pauseAfterMs": 50
          },
          {
            "text": "the girl",
            "locale": "en-US",
            "pauseAfterMs": 220
          },
          {
            "text": "flè a",
            "locale": "ht-HT",
            "pauseAfterMs": 50
          },
          {
            "text": "the flower",
            "locale": "en-US",
            "pauseAfterMs": 240
          },
          {
            "text": "Listen to the end of the noun before choosing the article",
            "locale": "en-US"
          }
        ]
      }
    },
