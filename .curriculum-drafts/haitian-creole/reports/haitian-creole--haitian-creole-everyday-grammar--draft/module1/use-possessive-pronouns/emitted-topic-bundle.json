            "locale": "ht-HT",
            "pauseAfterMs": 260
          },
          {
            "text": "ours",
            "locale": "en-US",
            "pauseAfterMs": 140
          },
          {
            "text": "pa nou an",
            "locale": "ht-HT",
            "pauseAfterMs": 140
          },
