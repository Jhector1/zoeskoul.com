            "pauseAfterMs": 260
          },
          {
            "text": "yours",
            "locale": "en-US",
            "pauseAfterMs": 140
          },
          {
            "text": "pa nou an",
            "locale": "ht-HT",
            "pauseAfterMs": 140
          },
          {
            "text": "pa n nan",
            "locale": "ht-HT",
            "pauseAfterMs": 260
          },
