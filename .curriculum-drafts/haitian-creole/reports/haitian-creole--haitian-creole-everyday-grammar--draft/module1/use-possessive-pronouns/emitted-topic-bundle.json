            "pauseAfterMs": 140
          },
          {
            "text": "pa ou a",
            "locale": "ht-HT",
            "pauseAfterMs": 140
          },
          {
            "text": "pa w la",
            "locale": "ht-HT",
            "pauseAfterMs": 260
          },
          {
            "text": "his / hers / its",
            "locale": "en-US",
            "pauseAfterMs": 140
          },
          {
            "text": "pa li a",
            "locale": "ht-HT",
            "pauseAfterMs": 140
          },
          {
