        "kind": "read_aloud",
        "locale": "ht-HT",
        "segments": [
          {
            "text": "To ask how someone is, use:",
            "locale": "en-US",
            "pauseAfterMs": 240
          },
          {
            "text": "Kijan ou ye?",
            "locale": "ht-HT",
            "pauseAfterMs": 240
          },
          {
            "text": "Listen to the question as one complete phrase.",
            "locale": "en-US"
          }
        ]
      }
