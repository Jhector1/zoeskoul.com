      "audio": {
        "kind": "read_aloud",
        "locale": "ht-HT",
        "segments": [
          {
            "text": "A simple complete answer is:",
            "locale": "en-US",
            "pauseAfterMs": 240
          },
          {
            "text": "Mwen byen, mèsi.",
            "locale": "ht-HT",
            "pauseAfterMs": 240
          },
          {
            "text": "A short answer is enough when it responds clearly.",
            "locale": "en-US"
          }
        ]
      }
    },
