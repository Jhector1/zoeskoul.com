{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ],
      "env": [
        "VITE_API_ORIGIN",
        "VITE_WEBSITE_ORIGIN",
        "LEARNOIR_STRIPE_SECRET_KEY",
        "NEXTAUTH_URL",
        "APP_ORIGIN",
        "STRIPE_ADAPTIVE_PRICING",
        "GUEST_COOKIE_SECRET",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "ZOESKOUL_GOOGLE_CLIENT_ID",
        "ZOESKOUL_GOOGLE_CLIENT_SECRET",
        "DATABASE_URL",
        "WEB_DATABASE_URL",
        "ADMIN_DATABASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": []
    }
  }
}
