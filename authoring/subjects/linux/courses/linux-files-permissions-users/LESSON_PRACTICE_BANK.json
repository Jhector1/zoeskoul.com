    "reading-permission-strings": {
      "moduleNumber": 1,
      "title": "Read Linux Permission Strings",
      "exercises": [
        {
          "id": "reading-permission-strings-q1",
          "kind": "single_choice",
          "prompt": "What does the first character d in drwxr-x--- mean?",
          "choices": [
            "Execute bit",
            "Directory",
            "Group member"
          ],
          "correctIndex": 1,
          "explanation": "The first character denotes the file type."
        },
        {
          "id": "reading-permission-strings-q2",
          "kind": "single_choice",
          "prompt": "Which triplet belongs to group in -rwxr-x---?",
          "choices": [
            "rwx",
            "r-x",
            "---"
          ],
          "correctIndex": 1,
          "explanation": "The middle triplet is the group mode."
        },
        {
          "id": "reading-permission-strings-q3",
          "kind": "single_choice",
          "prompt": "What is owner access for -rw-r-----?",
          "choices": [
            "Read/write",
            "Read-only",
            "Execute-only"
          ],
          "correctIndex": 0,
          "explanation": "Owner has r and w, not x."
        },
        {
          "id": "reading-permission-strings-practice",
          "kind": "code_input",
          "prompt": "Run ls -l on the provided secure-lab fixture; report type and three triplets. Press Enter.",
          "verificationPlan": "read_only_observation",
          "runtimeMode": "terminal_workspace",
          "recipeType": "shell_task",
          "releaseGate": "editorial_review"
        }
      ]
    },
