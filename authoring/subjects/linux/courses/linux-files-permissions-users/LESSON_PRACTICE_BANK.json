          "choices": [
            "Owner read",
            "Group and other read",
            "All writes"
          ],
          "correctIndex": 1,
          "explanation": "g/o selects group/other."
        },
        {
          "id": "symbolic-chmod-basics-q3",
          "kind": "single_choice",
          "prompt": "What does u=rw do?",
          "choices": [
            "Give owner exactly read/write",
            "Add execute to owner",
            "Change group ownership"
          ],
          "correctIndex": 0,
          "explanation": "= sets class bits precisely."
        },
        {
          "id": "symbolic-chmod-basics-practice",
          "kind": "code_input",
