{
  "policyId": "css-foundations-validation",
  "allowedConcepts": [
    "external stylesheets",
    "link element for stylesheets",
    "type selectors",
    "class selectors",
    "id selectors",
    "descendant selectors",
    "selector lists",
    "declarations",
    "properties",
    "values",
    "cascade",
    "inheritance",
    "specificity",
    "colors",
    "backgrounds",
    "font-family",
    "font-size",
    "font-weight",
    "line-height",
    "text alignment",
    "relative units",
    "absolute units",
    "width",
    "height",
    "max-width",
    "min-width",
    "margin",
    "padding",
    "border",
    "border-radius",
    "box-sizing",
    "display",
    "overflow",
    "Flexbox",
    "flex direction",
    "justify-content",
    "align-items",
    "gap",
    "flex-wrap",
    "flex grow",
    "flex shrink",
    "flex basis",
    "CSS Grid",
    "grid columns",
    "grid rows",
    "grid placement",
    "minmax",
    "repeat",
    "media queries",
    "mobile-first design",
    "responsive design",
    "custom properties",
    "reusable classes",
    "pseudo-classes",
    "hover states",
    "focus states",
    "focus-visible",
    "contrast",
    "responsive images",
    "maintainable CSS organization",
    "accessibility"
  ],
  "disallowedConcepts": [
    "JavaScript",
    "DOM scripting",
    "React",
    "Bootstrap",
    "Tailwind CSS",
    "CSS frameworks",
    "Sass",
    "Less",
    "CSS preprocessors",
    "npm",
    "package installation",
    "backend APIs",
    "advanced keyframe animation"
  ],
  "validationRequirements": {
    "usesWebProfile": true,
    "usesSourceChecksRecipe": true,
    "usesBrowserPreview": true,
    "judge0NotRequired": true,
    "stylesheetFile": "styles.css"
  },
  "rules": {
    "executionValidation": [
      "Every CSS code_input uses fixedLanguage web and recipeType source_checks",
      "Every source_checks exercise includes one or more sourceChecks entries",
      "Use path styles.css for CSS source checks unless a task explicitly needs to verify the provided HTML relationship",
      "Do not publish fixed_tests, template_io, semantic, shell_task, or sql_query recipes in CSS Foundations"
    ],
    "pedagogy": [
      "Every technical topic should include at least one visible browser-preview change",
      "Teach the cascade and box model before layout systems",
      "Teach Flexbox before Grid",
      "Treat keyboard focus and readable contrast as normal styling requirements rather than optional polish",
      "Do not grade harmless whitespace or declaration order unless the lesson explicitly teaches ordering"
    ]
  }
}
