{
  "name": "@zoeskoul/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @zoeskoul/progress-contracts build",
    "dev": "vite",
    "prebuild": "pnpm --filter @zoeskoul/progress-contracts build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm --filter @zoeskoul/progress-contracts build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @zoeskoul/progress-contracts build",
    "test": "vitest run",
    "lint": "eslint src vite.config.ts"
  },
  "dependencies": {
    "@zoeskoul/api-client": "workspace:*",
    "@zoeskoul/api-contracts": "workspace:*",
    "@zoeskoul/app-config": "workspace:*",
    "@zoeskoul/auth-client": "workspace:*",
    "@zoeskoul/practice-contracts": "workspace:*",
    "@zoeskoul/progress-contracts": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.1.5",
    "vitest": "^4.1.5"
  },
  "type": "module"
}
