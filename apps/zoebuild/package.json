{
  "name": "@zoeskoul/zoebuild",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "node ../../scripts/run-with-shared-env.mjs next dev --port 3004",
    "build": "next build",
    "start": "next start --port 3004",
    "typecheck": "tsc -p tsconfig.json --noEmit",
