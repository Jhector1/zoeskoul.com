# syntax=docker/dockerfile:1.7
# ZoeLearning-only identity layer. The base image is supplied as an immutable
# ghcr.io/<owner>/zoeskoul-runtime@sha256:... reference by a guarded workflow.
# Do NOT alter the shared ZoeBuild runtime or the separate admin-lab image.
ARG BASE_RUNTIME_IMAGE
FROM ${BASE_RUNTIME_IMAGE}

USER 0:0

RUN set -eux; \
  current_user="$(getent passwd 1000 | cut -d: -f1)"; \
  current_group="$(getent group 1000 | cut -d: -f1)"; \
  case "$current_user" in ubuntu|sandbox|zoelearner) ;; \
    *) echo 'Refusing unfamiliar UID 1000 account' >&2; exit 72 ;; \
  esac; \
  case "$current_group" in ubuntu|sandbox|zoelearner) ;; \
    *) echo 'Refusing unfamiliar GID 1000 group' >&2; exit 72 ;; \
  esac; \
  if [ "$current_user" != zoelearner ]; then \
    usermod --login zoelearner --home /home/zoelearner --move-home "$current_user"; \
  fi; \
  if [ "$current_group" != zoelearner ]; then \
    groupmod --new-name zoelearner "$current_group"; \
  fi; \
  test "$(id -u zoelearner)" = 1000; \
  test "$(id -g zoelearner)" = 1000; \
  test "$(getent passwd 1000 | cut -d: -f1)" = zoelearner; \
  test "$(getent group 1000 | cut -d: -f1)" = zoelearner

# Preserve the original sandbox's numeric non-root identity, entrypoint,
# root filesystem policy, and workspace bind mount behavior.
USER 1000:1000
