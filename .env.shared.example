# Shared local development infrastructure.
# Put real secret values in .env.shared.local only.

DATABASE_URL=
# ZoeBuild static publish
# Production must explicitly enable publishing.
ZOEBUILD_PUBLISH_ENABLED=0

# Production user-generated HTML must use a separate registrable domain
# from the authenticated ZoeBuild control plane.
# Example shape only: https://<your-dedicated-published-site-domain>
ZOEBUILD_PUBLISHED_SITE_ORIGIN=

# Server-only Zoéskoul Learning PTY Runner endpoints.
# HTTP and WebSocket endpoints have different schemes and may differ in deployment.
RUNNER_BASE_URL=
RUNNER_WS_BASE_URL=
