# Shared Caddy ingress; no runner secrets except Judge0 proxy-token.
COMPOSE_PROJECT_NAME=zoeskoul-runner-gateway
RUNNER_INGRESS_NETWORK=zoeskoul-runner-ingress
CADDY_IMAGE=caddy:2-alpine
CADDY_EMAIL=admin@zoeskoul.com
RUNNER_DOMAIN=runner.zoeskoul.com
JUDGE0_DOMAIN=judge0.zoeskoul.com
JUDGE0_AUTHN_TOKEN=CHANGE_ME_FROM_LEGACY_ENV

# Added by two-pool preflight V2b (missing example keys only)
RUNNER_PUBLIC_SMOKE=false

# Development: http; production: https
GATEWAY_SCHEME=https
