# ZoeBuild executor: independent rootless Docker daemon and storage.
COMPOSE_PROJECT_NAME=zoebuild-runner
RUNNER_EXECUTION_POOL=zoebuild
RUNNER_INGRESS_NETWORK=zoeskoul-runner-ingress
GHCR_OWNER=your-github-user-or-org-lowercase
IMAGE_TAG=prod
NODE_ENV=production
PORT=4001
RUNNER_SECRET=CHANGE_ME_FROM_LEGACY_ENV
RUNNER_SHARED_SECRET=CHANGE_ME_FROM_LEGACY_ENV
RUNNER_EDGE_SECRET=CHANGE_ME_FROM_LEGACY_ENV
PTY_ATTACH_SECRET=CHANGE_ME_FROM_LEGACY_ENV
RUNNER_ATTACH_TOKEN_SECRET=CHANGE_ME_FROM_LEGACY_ENV
RUNNER_ALLOWED_ORIGINS=https://zoeskoul.com,https://www.zoeskoul.com
RUNNER_CORS_ORIGIN=https://zoeskoul.com
ALLOWED_WEB_ORIGINS=https://zoeskoul.com,https://www.zoeskoul.com
WEB_URL=https://zoeskoul.com
RUNNER_DOCKER_SOCKET_HOST=REPLACE_WITH_DEDICATED_ZOEBUILD_ROOTLESS_SOCKET
RUNNER_DOCKER_SOCKET_IN_CONTAINER=/docker.sock
RUNNER_CONTAINER_USER=REPLACE_WITH_DEDICATED_EXECUTOR_UID_GID
RUNNER_WORKSPACE_HOST_ROOT=/var/lib/zoebuild-runner/workspaces
RUNNER_SERVICE_MEM_LIMIT=512m
RUNNER_SERVICE_CPUS=1.0
RUNNER_MEMORY_LIMIT_MB=256
RUNNER_CPU_QUOTA=100000
RUNNER_PIDS_LIMIT=128
RUNNER_CHILD_NETWORK=none
RUNNER_DISABLE_NETWORK=true
RUNNER_MAX_CONCURRENT_PER_ACTOR=2
RUNNER_MAX_CONCURRENT_GLOBAL=3
RUNNER_STARTS_PER_MINUTE_PER_ACTOR=5
RUNNER_SESSION_TTL_MS=1800000
RUNNER_WORKSPACE_TTL_MS=600000
RUN_WALL_TIMEOUT_MS=15000
RUN_IDLE_TIMEOUT_MS=20000
RUNNER_MAX_FILES=256
RUNNER_MAX_TOTAL_BYTES=4194304
RUNNER_MAX_FILE_BYTES=524288
RUNNER_MAX_ENTRIES=1000
RUNNER_MAX_RUNTIME_ENTRIES=2000
RUNNER_MIN_FREE_BYTES=8589934592
RUNNER_MIN_FREE_PERCENT=10
RUNNER_MAX_WORKSPACE_ROOT_BYTES=10737418240
RUNNER_WORKSPACE_PRESSURE_CHECK_MS=500
RUNNER_DEPLOY_MIN_FREE_BYTES=12884901888
RUNNER_DEPLOY_MIN_FREE_PERCENT=15
RUNNER_JOURNAL_VACUUM_SIZE=512M
