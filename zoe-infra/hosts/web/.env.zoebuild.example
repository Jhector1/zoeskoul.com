# WEB-HOST ONLY. Copy to .env.zoebuild (chmod 600, never commit).
# .env for regular Zoéskoul Web is unchanged. This file is read only by deploy-zoebuild.sh.
GHCR_OWNER=jhector1
GITHUB_SOURCE_REPO=jhector1/zoeskoul.com
# Auto-selected from latest successful manual GH Actions build, or explicit deploy SHA.
ZOEBUILD_IMAGE_TAG=replace-with-40-character-image-commit-sha
# Two independently generated random secrets (at least 32 bytes each), never equal.
ZOEBUILD_EDGE_SHARED_SECRET=replace-with-strong-distinct-edge-secret
ZOEBUILD_BUYER_IP_SIGNING_KEY=replace-with-strong-distinct-hmac-signing-key
ZOEBUILD_DOMAIN=build.zoeskoul.com
ZOEBUILD_APP_MEM_LIMIT=768m
ZOEBUILD_APP_CPUS=0.5
# Change to 'yes' only after production WEB HOST, Caddy, database and shared auth are verified.
ZOEBUILD_WEB_HOST_DB_AUTH_CONFIRMED=no
ZOEBUILD_EDGE_CLIENT_IP_CHAIN_CONFIRMED=no
ZOEBUILD_CADDY_INGRESS_INSTALLED_CONFIRMED=no
