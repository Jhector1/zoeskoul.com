# WEB-HOST ZoeBuild app environment. Copy to .env.zoebuild.app, chmod 600.
# Use the *existing* Zoéskoul application PostgreSQL database on webnet.
# Values must be populated securely on WEB host, NOT runner VM.
DATABASE_URL=postgresql://WEB_DB_USER:WEB_DB_PASSWORD@postgres:5432/zoeskoul?schema=public
# MUST match compatible Zoéskoul shared-auth config, not a new identity system.
AUTH_SECRET=replace-with-existing-web-compatible-auth-secret
NEXTAUTH_SECRET=replace-with-existing-web-compatible-auth-secret
NEXTAUTH_URL=https://zoeskoul.com
# Same existing Runner API, accessed by ZoeBuild over a trusted server-to-server route.
RUNNER_BASE_URL=http://10.10.0.3:4001
# Add any application AI/provider settings privately, never to Compose interpolation file.
