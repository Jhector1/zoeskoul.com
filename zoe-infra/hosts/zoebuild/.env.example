# Compose interpolation ONLY. Copy to .env on the existing runner host.
# Never commit .env or include the values in terminal output.
GHCR_OWNER=your-ghcr-owner
# Set to the validated image's immutable commit SHA, not prod/latest.
IMAGE_TAG=replace-with-40-char-commit-sha
# Independently generated >=32 byte secrets. Signer receives both;
# ZoeBuild receives ONLY the HMAC key; existing Caddy gets ONLY the edge secret.
ZOEBUILD_EDGE_SHARED_SECRET=replace-with-random-secret-at-least-32-bytes
ZOEBUILD_BUYER_IP_SIGNING_KEY=replace-with-DIFFERENT-random-secret-at-least-32-bytes
ZOEBUILD_DOMAIN=build.example.com
ZOEBUILD_APP_MEM_LIMIT=1536m
ZOEBUILD_APP_CPUS=1.0
