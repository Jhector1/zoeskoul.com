# VirtualBox-only localhost HTTP proxy. The existing runner Caddy is not modified.
:8080 {
    @internal path /_zoebuild_internal/*
    respond @internal 404
    reverse_proxy zoebuild-ingress-signer:8090 {
        header_up -X-ZoeBuild-Buyer-IP
        header_up -X-ZoeBuild-Buyer-IP-Timestamp
        header_up -X-ZoeBuild-Buyer-IP-Signature
        header_up -X-ZoeBuild-Edge-Auth
        header_up -X-ZoeBuild-Edge-IP
        header_up X-ZoeBuild-Edge-Auth {$ZOEBUILD_EDGE_SHARED_SECRET}
        header_up X-ZoeBuild-Edge-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}
