# ZoeBuild app environment (used only by the zoebuild service).
# Copy to .env.app, restrict filesystem permissions, and provide real values.
# Never store ingress edge secret here: it belongs to Caddy + signer only.
DATABASE_URL=postgresql://USER:PASS@PRIVATE_DB_HOST:5432/DATABASE
AUTH_SECRET=replace-with-shared-Zoéskoul-session-configuration
# Configure existing required provider/AI service vars through secure deployment.
# Do NOT enable Shopify OAuth/publishing/runtime until separate acceptance gates.
