            "locale": "en-US",
            "pauseAfterMs": 220
          },
          {
            "text": "The person's name changes; the pattern stays the same:",
            "locale": "en-US",
            "pauseAfterMs": 240
          },
          {
            "text": "M rele + name",
            "locale": "en-US"
          }
        ]
