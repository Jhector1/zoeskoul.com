            "locale": "en-US",
            "pauseAfterMs": 240
          },
          {
            "text": "liv yo",
            "locale": "ht-HT",
            "pauseAfterMs": 50
          },
          {
            "text": "the books",
            "locale": "en-US",
            "pauseAfterMs": 220
          },
          {
            "text": "kaye yo",
            "locale": "ht-HT",
            "pauseAfterMs": 50
          },
          {
            "text": "the notebooks",
            "locale": "en-US",
            "pauseAfterMs": 220
