          {
            "text": "greet or close",
            "locale": "en-US",
            "pauseAfterMs": 220
          },
          {
            "text": "answer and return a question",
            "locale": "en-US",
            "pauseAfterMs": 220
          },
          {
            "text": "ask for new information",
            "locale": "en-US",
            "pauseAfterMs": 220
          },
          {
            "text": "talk about an action",
            "locale": "en-US",
            "pauseAfterMs": 220
          },
          {
            "text": "give a quantity or time",
            "locale": "en-US",
            "pauseAfterMs": 220
          },
          {
            "text": "You do not need to memorize this conversation word for word.",
            "locale": "en-US"
          }
        ]
