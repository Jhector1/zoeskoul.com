        "solutionFiles": [
          {
            "path": "main.py",
            "content": "def clean_row(row):\n    name = row[0].strip()\n    score_text = row[1].strip()\n\n    if name == \"\":\n        return None\n\n    try:\n        score = int(score_text)\n    except ValueError:\n        return None\n\n    return {\"name\": name.title(), \"score\": score}",
            "language": "python",
            "isEntry": true,
