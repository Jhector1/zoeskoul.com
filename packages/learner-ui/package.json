{
  "name": "@zoeskoul/learner-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ai-tutor/*": "./src/ai-tutor/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./sketches/*": "./src/sketches/*.ts",
    "./vectorpad/*": "./src/vectorpad/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/learner-ui/src/achievements.test.ts packages/learner-ui/src/HeaderChrome.test.ts packages/learner-ui/src/ThemeToggle.test.ts packages/learner-ui/src/UserMenuChrome.test.ts packages/learner-ui/src/LocaleSwitcherChrome.test.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "tailwind-merge": "^3.4.0",
    "@zoeskoul/curriculum-contracts": "workspace:*",
    "@zoeskoul/permissions": "workspace:*",
    "@zoeskoul/practice-contracts": "workspace:*",
    "@zoeskoul/preferences": "workspace:*",
    "next-themes": "^0.4.6"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "^19.0.0",
    "react": "19.2.3",
    "vitest": "^4.1.5"
  }
}
