model TutoringCreditPurchase {
  id                      String                       @id @default(cuid())
  userId                  String
  checkoutAttemptId       String                       @unique
  packageMinutes          Int
  amountMinor             Int
  currency                String                       @db.VarChar(3)
  stripePriceId           String?
  stripeCheckoutSessionId String?                      @unique
  stripePaymentIntentId   String?                      @unique
  status                  TutoringCreditPurchaseStatus @default(pending)
  checkoutExpiresAt       DateTime?
  paidAt                  DateTime?
  failedAt                DateTime?
  canceledAt              DateTime?
  refundedAt              DateTime?
  meta                    Json?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  user                    User                         @relation("TutoringCreditPurchaseUser", fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries           TutoringCreditLedgerEntry[]
  refunds                 TutoringCreditRefund[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model TutoringCreditRefund {
  id              String                     @id @default(cuid())
  purchaseId      String
  userId          String
  refundAttemptId String                     @unique
  minutes         Int
  amountMinor     Int
  currency        String                     @db.VarChar(3)
  stripeRefundId  String?                    @unique
  status          TutoringCreditRefundStatus @default(pending)
  requestedAt     DateTime                   @default(now())
  succeededAt     DateTime?
  failedAt        DateTime?
  canceledAt      DateTime?
  failureReason   String?
  meta            Json?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  purchase        TutoringCreditPurchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([purchaseId, createdAt])
  @@index([status, createdAt])
}

model TutoringCreditLedgerEntry {
  id                    String                   @id @default(cuid())
  userId                String
  kind                  TutoringCreditLedgerKind
  availableMinutesDelta Int
  reservedMinutesDelta  Int                      @default(0)
  purchaseId            String?
  requestId             String?
  bookingId             String?
  idempotencyKey        String                   @unique
  meta                  Json?
  createdAt             DateTime                 @default(now())
  user                  User                     @relation("TutoringCreditLedgerUser", fields: [userId], references: [id], onDelete: Cascade)
  purchase              TutoringCreditPurchase?  @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  request               TutoringRequest?         @relation(fields: [requestId], references: [id], onDelete: SetNull)
  booking               TutoringBooking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([purchaseId])
  @@index([requestId])
  @@index([bookingId])
  @@index([kind])
}

model TutoringRequest {
  id                String                      @id @default(cuid())
  learnerId         String
  requestAttemptId  String                      @unique
  assignedTeacherId String?
  tutoringSessionId String?                     @unique
  status            TutoringRequestStatus       @default(requested)
  requestedMinutes  Int
  preferredStartsAt DateTime?
  sourceSubjectSlug String?
  sourceModuleSlug  String?
  sourceExerciseKey String?
  note              String?
  meta              Json?
  assignedAt        DateTime?
  scheduledAt       DateTime?
  completedAt       DateTime?
  canceledAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  learner           User                        @relation("TutoringRequestLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  assignedTeacher   User?                       @relation("TutoringRequestAssignedTeacher", fields: [assignedTeacherId], references: [id], onDelete: SetNull)
  tutoringSession   TutoringSession?            @relation("TutoringRequestSession", fields: [tutoringSessionId], references: [id], onDelete: SetNull)
  bookings          TutoringBooking[]
  ledgerEntries     TutoringCreditLedgerEntry[]

  @@index([learnerId, status, createdAt])
  @@index([assignedTeacherId, status, createdAt])
  @@index([status, createdAt])
}

model TutoringBooking {
  id                String                      @id @default(cuid())
  requestId         String
  teacherId         String?
  tutoringSessionId String?                     @unique
  startsAt          DateTime
  durationMinutes   Int
  status            TutoringBookingStatus       @default(scheduled)
  creditReservedAt  DateTime?
  creditConsumedAt  DateTime?
  creditReleasedAt  DateTime?
  completedAt       DateTime?
  canceledAt        DateTime?
  meta              Json?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  request           TutoringRequest             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  teacher           User?                       @relation("TutoringBookingTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  tutoringSession   TutoringSession?            @relation("TutoringBookingSession", fields: [tutoringSessionId], references: [id], onDelete: SetNull)
  ledgerEntries     TutoringCreditLedgerEntry[]

  @@index([requestId, status])
  @@index([teacherId, startsAt, status])
  @@index([status, startsAt])
}

model StudentCampaign {
  id                   String                    @id @default(cuid())
  name                 String
  title                String
  body                 String                    @db.Text
