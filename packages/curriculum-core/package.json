{
  "name": "@zoeskoul/curriculum-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./topic-meta": {
      "types": "./dist/topicMeta.d.ts",
      "browser": "./dist/topicMeta.js",
      "import": "./dist/topicMeta.js",
      "default": "./dist/topicMeta.js"
    },
    "./with-topic-parent-context": {
      "types": "./dist/withTopicParentContext.d.ts",
      "browser": "./dist/withTopicParentContext.js",
      "import": "./dist/withTopicParentContext.js",
      "default": "./dist/withTopicParentContext.js"
    },
    "./sql-datasets": {
      "types": "./dist/sql/datasets/index.d.ts",
      "browser": "./dist/sql/datasets/index.js",
      "import": "./dist/sql/datasets/index.js",
      "default": "./dist/sql/datasets/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "vitest run --root ../.. packages/curriculum-core/src"
  },
  "dependencies": {
    "@zoeskoul/curriculum-contracts": "workspace:*"
  }
}
