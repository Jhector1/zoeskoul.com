{
  "name": "@zoeskoul/curriculum-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./sql": {
      "types": "./dist/sql/index.d.ts",
      "default": "./dist/sql/index.js"
    },
    "./sql/local": {
      "types": "./dist/sql/local.d.ts",
      "default": "./dist/sql/local.js"
    },
    "./review": {
      "types": "./dist/review/index.d.ts",
      "default": "./dist/review/index.js"
    },
    "./compat/*": {
      "types": "./dist/compat/*.d.ts",
      "default": "./dist/compat/*.js"
    },
    "./curriculum/*": {
      "types": "./dist/curriculum/*.d.ts",
      "default": "./dist/curriculum/*.js"
    },
    "./curriculum/resolveManifestExercise": {
      "types": "./dist/curriculum/resolveManifestExercise.d.ts",
      "default": "./dist/curriculum/resolveManifestExercise.js"
    },
    "./subjects/sql/sql/runtime/resolveSqlRunnerConfig": {
      "types": "./dist/subjects/sql/sql/runtime/resolveSqlRunnerConfig.d.ts",
      "default": "./dist/subjects/sql/sql/runtime/resolveSqlRunnerConfig.js"
    },
    "./subjects/sql/sql/datasets": {
      "types": "./dist/subjects/sql/sql/datasets/index.d.ts",
      "default": "./dist/subjects/sql/sql/datasets/index.js"
    },
    "./subjects/*": {
      "types": "./dist/subjects/*.d.ts",
      "default": "./dist/subjects/*.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @zoeskoul/curriculum-contracts build && pnpm --filter @zoeskoul/curriculum-core build",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "pretest": "pnpm --filter @zoeskoul/curriculum-core build && pnpm --filter @zoeskoul/curriculum-contracts build",
    "test": "vitest run --root ../.. packages/curriculum-runtime/src"
  },
  "dependencies": {
    "@zoeskoul/curriculum-contracts": "workspace:*",
    "@zoeskoul/curriculum-core": "workspace:*",
    "@zoeskoul/i18n-core": "workspace:*",
    "@zoeskoul/practice-contracts": "workspace:*",
    "@zoeskoul/practice-checks": "workspace:*",
    "jszip": "^3.10.1"
  }
}
