{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@zoeskoul/provider-platform": [
        "../provider-platform/src/index.ts"
      ],
      "@zoeskoul/provider-contracts": [
        "../provider-contracts/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
